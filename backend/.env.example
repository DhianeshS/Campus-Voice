# ==============================================================================
# CampusVoice Backend Environment Configuration Template
# Copy this file to .env for local development.
# IMPORTANT: NEVER commit real passwords or service role keys to Git.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Allowed Origins (CORS)
# Supports single URL or comma-separated list of allowed origins
CLIENT_URL=http://localhost:5173

# Direct PostgreSQL Database Connection on Supabase
# Obtain from: Supabase Console -> Project Settings -> Database -> Connection string (URI)
# Format for Transaction Pooler (Port 6543) or Session Pooler (Port 5432):
# postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_SSL=true
DATABASE_MAX_CONNECTIONS=20

# Supabase Auth and Client Configuration
# Obtain from: Supabase Console -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Email Notification Provider Configuration (Optional)
# Supports 'resend', 'sendgrid', 'smtp', or 'none' (default)
EMAIL_PROVIDER=none
EMAIL_FROM="CampusVoice <notifications@campusvoice.edu>"
RESEND_API_KEY=re_your_resend_api_key_here
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-domain.com
SMTP_PASS=your-smtp-password

