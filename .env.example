# ==============================================================================
# CampusVoice Workspace Environment Variables Template
# Copy this file to .env or configure in your deployment environments (Render/Vercel)
# ==============================================================================

# --- Backend Configuration (Express & Node.js) ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection (Supabase Hosted)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_SSL=true
DATABASE_MAX_CONNECTIONS=20

# Supabase Project Credentials
# Obtain from https://supabase.com -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# --- Frontend Configuration (Vite + React) ---
VITE_API_URL=http://localhost:5000/api/v1
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Email Notification Provider Configuration (Optional) ---
# Supports 'resend', 'sendgrid', 'smtp', or 'none' (default)
EMAIL_PROVIDER=none
EMAIL_FROM="CampusVoice <notifications@campusvoice.edu>"
RESEND_API_KEY=re_your_resend_api_key_here
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-domain.com
SMTP_PASS=your-smtp-password

