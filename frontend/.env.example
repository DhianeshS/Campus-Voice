# CampusVoice Frontend Environment Variables Example
# Duplicate this file as .env or .env.local for local development.
# Do NOT commit production keys or sensitive credentials.

# Express Backend Base URL (Vite client)
VITE_API_URL=http://localhost:5000/api/v1

# Supabase Project Configuration (Stage 2)
# Found under Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
